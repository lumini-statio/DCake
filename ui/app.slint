import { Palette } from "std-widgets.slint";
import { Group } from "components/types.slint";
import { Sidebar } from "components/sidebar.slint";
import { ChatView } from "components/chat-view.slint";
import { CallView } from "components/call-view.slint";
import { JoinCard } from "components/join-card.slint";
import { AuthView } from "components/auth-view.slint";
import { AccountsView } from "components/accounts-view.slint";
import { Account } from "components/types.slint";
import { Loading } from "components/loading.slint";

// Re-exportados para que Rust genere los structs.
export { Message, User, Group, Account } from "components/types.slint";

export component AppWindow inherits Window {
    title: "Chat";
    preferred-width: 1000px;
    preferred-height: 650px;
    background: #1e1f22;
    forward-focus: fs;

    in property <[Group]> groups;
    in-out property <int> selected: -1;
    in-out property <bool> in-call;
    in-out property <bool> cam-on: true;
    in-out property <bool> mic-on: true;
    callback send(int, string);
    // Carga los mensajes del chat si no están en memoria.
    callback open-chat(int);
    // Rust responde poniendo join-error o llamando a joined().
    callback join-group(string);
    // Rust responde poniendo auth-error y logged-in.
    callback login(string, string);
    callback register(string, string, string, string);
    // Hay una operación bloqueante en curso: se muestra la animación de carga.
    in property <bool> busy;
    in-out property <bool> logged-in;
    // Cuentas de data.json; mientras choosing-account sea true se muestra el panel de cuentas.
    in property <[Account]> accounts;
    in-out property <bool> choosing-account;
    // Entra con una cuenta que ya tiene la sesión iniciada. Rust responde poniendo auth-error y logged-in.
    callback enter-account(string);

    property <Group> current: groups[selected];
    in-out property <string> join-error;
    in-out property <string> auth-error;

    init => { Palette.color-scheme = ColorScheme.dark; }

    // open-chat se ignora mientras hay otra operación en curso: al terminar, se carga el chat actual.
    // Si ya está en memoria, open-chat no consulta nada.
    changed busy => {
        if !busy && selected >= 0 {
            root.open-chat(selected);
        }
    }

    // Rust la llama cuando join-group terminó bien.
    public function joined() {
        join-error = "";
        join-popup.close();
        selected = 0;
        root.open-chat(selected);
        chat.reset();
    }

    fs := FocusScope {
        capture-key-pressed(e) => {
            if e.text == Key.Escape && selected >= 0 {
                selected = -1;
                in-call = false;
                fs.focus();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            Sidebar {
                groups: groups;
                selected: selected;
                add-clicked => {
                    join-error = "";
                    join-popup.show();
                }
                group-clicked(i) => {
                    selected = i;
                    root.open-chat(i);
                    in-call = false;
                    chat.reset();
                }
            }

            // Espacio de chat
            Rectangle {
                background: #2b2d31;

                if selected < 0: Text {
                    text: "Seleccioná un chat";
                    color: #80848e;
                    font-size: 16px;
                }

                chat := ChatView {
                    visible: selected >= 0 && !in-call;
                    current: current;
                    send(text) => { root.send(selected, text); }
                    start-call => { in-call = true; }
                }

                // Videollamada: ocupa todo el espacio de chat
                if selected >= 0 && in-call: CallView {
                    participants: current.participants;
                    cam-on <=> root.cam-on;
                    mic-on <=> root.mic-on;
                    hang-up => {
                        in-call = false;
                        chat.reset();
                    }
                }
            }
        }

        // Popup modal para unirse a un grupo
        join-popup := PopupWindow {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            close-policy: PopupClosePolicy.no-auto-close;

            // Fondo oscuro: click afuera cierra
            Rectangle {
                background: #000000a0;
                TouchArea { clicked => { join-popup.close(); } }
            }

            JoinCard {
                error: join-error;
                submit(code) => { root.join-group(code); }
                cancel => { join-popup.close(); }
            }

            // El popup se dibuja sobre la ventana: necesita su propia animación de carga.
            if root.busy: Loading { }
        }
    }

    if !logged-in && choosing-account: AccountsView {
        accounts: root.accounts;
        error: auth-error;
        enter(nick) => {
            root.enter-account(nick);
        }
        login(email, pass) => {
            root.login(email, pass);
        }
        other-account => {
            auth-error = "";
            choosing-account = false;
        }
    }

    if !logged-in && !choosing-account: AuthView {
        error: auth-error;
        login(email, pass) => {
            root.login(email, pass);
        }
        register(name, nick, email, pass) => {
            root.register(name, nick, email, pass);
        }
    }

    if busy: Loading { }
}
