export struct Message { from: string, text: string, mine: bool }
export struct User { name: string, initial: string, color: color, cam: bool }
export struct Group {
    id: string,
    name: string,
    initial: string,
    icon: image,
    color: color,
    messages: [Message],
    participants: [User],
}
